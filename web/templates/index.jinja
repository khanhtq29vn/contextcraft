<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ContextCraft</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
    :root {
      --bg: #f6f7f5;
      --surface: #ffffff;
      --border: #dfe2dc;
      --text: #1d2420;
      --muted: #66706a;
      --accent: #1f7a5a;
      --accent-text: #ffffff;
      --danger: #b4352a;
      --mono: "IBM Plex Mono", ui-monospace, monospace;
      --sans: "IBM Plex Sans", system-ui, sans-serif;
      --control-h: 44px;
      --action-w: 150px;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #131614;
        --surface: #1b1f1c;
        --border: #2d332f;
        --text: #e4e8e5;
        --muted: #8f9a93;
        --accent: #4cc493;
        --accent-text: #0e1a14;
        --danger: #f08a7f;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font: 15px/1.5 var(--sans);
      -webkit-font-smoothing: antialiased;
    }
    main { max-width: 1100px; margin: 0 auto; padding: 32px 16px 64px; }
    header { display: flex; align-items: baseline; gap: 10px; margin-bottom: 4px; }
    h1 { font-size: 22px; font-weight: 600; margin: 0; }
    .version { color: var(--muted); font: 13px var(--mono); }
    .lede { color: var(--muted); margin: 0 0 24px; }

    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
    }
    form { padding: 20px; display: grid; gap: 16px; }
    .row { display: grid; grid-template-columns: 1fr 180px var(--action-w); gap: 12px; align-items: end; }
    label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 6px; }
    input[type="text"], select {
      width: 100%;
      height: var(--control-h);
      padding: 0 12px;
      font: 16px/1 var(--sans);
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    input.mono { font-family: var(--mono); font-size: 16px; }
    select {
      appearance: none;
      padding-right: 36px;
      background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%),
        linear-gradient(135deg, var(--muted) 50%, transparent 50%);
      background-position: calc(100% - 18px) 50%, calc(100% - 13px) 50%;
      background-size: 5px 5px;
      background-repeat: no-repeat;
    }
    input[type="checkbox"] { width: 18px; height: 18px; margin: 0; accent-color: var(--accent); }
    input:focus, select:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
    button {
      font: 500 14px var(--sans);
      cursor: pointer;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      padding: 0 14px;
      height: var(--control-h);
      touch-action: manipulation;
      transition: border-color 150ms ease-out, background-color 150ms ease-out, filter 150ms ease-out;
    }
    button:hover { border-color: var(--muted); }
    button:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    button.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-text);
      padding: 0 22px;
      font-weight: 600;
    }
    button.primary:hover { filter: brightness(1.08); }
    button:disabled { opacity: 0.6; cursor: progress; }
    .spinner {
      display: inline-block;
      width: 14px;
      height: 14px;
      margin-right: 8px;
      vertical-align: -2px;
      border: 2px solid currentColor;
      border-right-color: transparent;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    #results[aria-busy="true"] { opacity: 0.5; transition: opacity 200ms ease-out; }
    @media (prefers-reduced-motion: reduce) {
      .spinner { animation: none; border-right-color: currentColor; opacity: 0.6; }
      * { transition: none !important; }
    }

    details summary { cursor: pointer; color: var(--muted); font-size: 14px; width: fit-content; }
    details[open] summary { margin-bottom: 12px; }
    .options { display: grid; grid-template-columns: 1fr 180px var(--action-w); gap: 12px; align-items: start; }
    .check { display: flex; align-items: center; gap: 8px; font-size: 14px; margin-top: 12px; }
    .hint { color: var(--muted); font-size: 13px; margin-top: 4px; }

    .error {
      margin-top: 16px;
      padding: 12px 16px;
      border-radius: 8px;
      border: 1px solid var(--danger);
      color: var(--danger);
      font-size: 14px;
    }

    #results { margin-top: 24px; }
    .summary { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-bottom: 16px; }
    .summary div { font-size: 13px; color: var(--muted); }
    .summary strong { display: block; font: 500 20px var(--mono); color: var(--text); }

    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      border-bottom: 1px solid var(--border);
    }
    .tabs { display: flex; gap: 4px; }
    .tabs button { border-color: transparent; background: none; color: var(--muted); }
    .tabs button[aria-selected="true"] { color: var(--text); background: var(--bg); border-color: var(--border); }
    .actions { display: flex; gap: 8px; }

    pre {
      margin: 0;
      padding: 16px;
      max-height: 65vh;
      overflow: auto;
      font: 13px/1.6 var(--mono);
      white-space: pre;
    }
    .table-wrap { max-height: 65vh; overflow: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--border); }
    th { position: sticky; top: 0; background: var(--surface); color: var(--muted); font-weight: 500; }
    td.path { font-family: var(--mono); overflow-wrap: anywhere; }
    td.num, th.num { text-align: right; white-space: nowrap; }
    td.num { font-family: var(--mono); }
    .tier { font: 500 12px var(--mono); color: var(--muted); }
    .tier.FULL { color: var(--accent); }

    @media (max-width: 720px) {
      .row, .options { grid-template-columns: 1fr; }
      button.primary { width: 100%; }
      .toolbar { flex-wrap: wrap; }
      .col-importance { display: none; }
      th, td { padding: 8px; }
    }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>ContextCraft</h1>
        <span class="version">v{{ version }}</span>
      </header>
      <p class="lede">
        Shrink a repository into an LLM prompt that fits your token budget.
      </p>

      <section class="panel">
        <form id="compileForm">
          <div class="row">
            <div>
              <label for="sourceInput">Repository</label>
              <input
                type="text"
                id="sourceInput"
                class="mono"
                value="{{ initial_source }}"
                placeholder=". or https://github.com/owner/repo"
                required
              />
            </div>
            <div>
              <label for="budgetInput">Token budget</label>
              <input
                type="text"
                id="budgetInput"
                class="mono"
                value="{{ initial_budget }}"
                list="budgetPresets"
                placeholder="16k"
                required
              />
              <datalist id="budgetPresets">
                <option value="4k"></option>
                <option value="8k"></option>
                <option value="16k"></option>
                <option value="32k"></option>
                <option value="64k"></option>
              </datalist>
            </div>
            <button type="submit" id="compileBtn" class="primary">Compress</button>
          </div>

          <details {% if initial_focus %}open{% endif %}>
            <summary>More options</summary>
            <div class="options">
              <div>
                <label for="focusInput">Focus</label>
                <input
                  type="text"
                  id="focusInput"
                  value="{{ initial_focus }}"
                  placeholder="e.g. authentication middleware"
                />
                <div class="hint">Files related to this topic are kept in more detail.</div>
              </div>
              <div>
                <label for="formatSelect">Format</label>
                <select id="formatSelect">
                  <option value="markdown" {% if initial_format == 'markdown' %}selected{% endif %}>Markdown</option>
                  <option value="xml" {% if initial_format == 'xml' %}selected{% endif %}>XML</option>
                  <option value="json" {% if initial_format == 'json' %}selected{% endif %}>JSON</option>
                </select>
              </div>
            </div>
            <label class="check">
              <input type="checkbox" id="redactCheckbox" checked />
              Hide API keys and secrets
            </label>
          </details>
        </form>
      </section>

      <div id="errorBanner" class="error" role="alert" hidden></div>

      <section id="results" hidden>
        <div class="summary">
          <div><strong id="statTokens">-</strong>tokens used</div>
          <div><strong id="statRatio">-</strong>smaller than the original</div>
          <div><strong id="statFiles">-</strong>files</div>
          <div><strong id="statSecrets">-</strong>secrets hidden</div>
        </div>

        <div class="panel">
          <div class="toolbar">
            <div class="tabs" role="tablist" aria-label="Result view">
              <button type="button" role="tab" id="tab-output" aria-selected="true" aria-controls="artifactOutput" data-tab="output">Output</button>
              <button type="button" role="tab" id="tab-files" aria-selected="false" aria-controls="filesPanel" tabindex="-1" data-tab="files">Files</button>
            </div>
            <div class="actions">
              <button type="button" id="copyBtn">Copy output</button>
              <button type="button" id="downloadBtn">Download</button>
            </div>
          </div>
          <pre id="artifactOutput" role="tabpanel" aria-labelledby="tab-output" tabindex="0" data-panel="output"></pre>
          <div class="table-wrap" id="filesPanel" role="tabpanel" aria-labelledby="tab-files" tabindex="0" data-panel="files" hidden>
            <table>
              <thead>
                <tr>
                  <th>File</th>
                  <th>Detail</th>
                  <th class="num col-importance">Importance</th>
                  <th class="num">Tokens</th>
                </tr>
              </thead>
              <tbody id="filesTableBody"></tbody>
            </table>
          </div>
        </div>
      </section>
    </main>

    <script>
    const $ = (id) => document.getElementById(id);
    const TIER_LABELS = { FULL: "Full", SKEL: "Outline", SIGS: "Signatures", TREE: "Name only" };
    let latestContent = "";
    let latestFormat = "markdown";

    function escapeHtml(text) {
      return String(text).replace(/[&<>"']/g, (c) => (
        { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]
      ));
    }

    async function runCompilation(e) {
      if (e) e.preventDefault();
      const btn = $("compileBtn");
      $("errorBanner").hidden = true;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner" aria-hidden="true"></span>Compressing…';
      $("results").setAttribute("aria-busy", "true");

      const payload = {
        source: $("sourceInput").value.trim() || ".",
        budget: $("budgetInput").value.trim() || "16k",
        focus_query: $("focusInput").value.trim() || null,
        output_format: $("formatSelect").value,
        redact_secrets: $("redactCheckbox").checked
      };

      try {
        const resp = await fetch("/api/compile", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const data = await resp.json();
        if (!resp.ok) {
          const detail = Array.isArray(data.detail)
            ? data.detail.map((d) => d.msg).join("; ")
            : data.detail;
          throw new Error(detail || "Compression failed.");
        }

        latestContent = data.content;
        latestFormat = data.output_format;
        const s = data.stats;

        $("statTokens").textContent = `${s.compressed_tokens.toLocaleString()} / ${s.budget_tokens.toLocaleString()}`;
        $("statRatio").textContent = `${s.compression_ratio}×`;
        $("statFiles").textContent = s.files_compiled.toLocaleString();
        $("statSecrets").textContent = s.secrets_redacted.toLocaleString();
        $("artifactOutput").textContent = data.content;

        $("filesTableBody").innerHTML = data.files.map((f) => `
          <tr>
            <td class="path">${escapeHtml(f.rel_path).replaceAll("/", "/<wbr>")}</td>
            <td><span class="tier ${escapeHtml(f.fidelity)}">${escapeHtml(TIER_LABELS[f.fidelity] || f.fidelity)}</span></td>
            <td class="num col-importance">${f.pagerank_pct.toFixed(1)}%</td>
            <td class="num">${f.selected_tokens.toLocaleString()}</td>
          </tr>
        `).join("");

        $("results").hidden = false;
      } catch (err) {
        $("errorBanner").textContent = err.message;
        $("errorBanner").hidden = false;
      } finally {
        btn.disabled = false;
        btn.textContent = "Compress";
        $("results").removeAttribute("aria-busy");
      }
    }

    function showTab(name) {
      document.querySelectorAll("[role=tab]").forEach((tab) => {
        const selected = tab.dataset.tab === name;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      document.querySelectorAll("[data-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.panel !== name;
      });
    }

    async function copyArtifact() {
      if (!latestContent) return;
      try {
        await navigator.clipboard.writeText(latestContent);
      } catch {
        // navigator.clipboard is unavailable over plain HTTP on a LAN address.
        const area = document.createElement("textarea");
        area.value = latestContent;
        document.body.appendChild(area);
        area.select();
        document.execCommand("copy");
        area.remove();
      }
      $("copyBtn").textContent = "Copied";
      setTimeout(() => { $("copyBtn").textContent = "Copy output"; }, 1500);
    }

    function downloadArtifact() {
      if (!latestContent) return;
      const ext = { markdown: "md", xml: "xml", json: "json" }[latestFormat] || "txt";
      const blob = new Blob([latestContent], { type: "text/plain;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `contextcraft_output.${ext}`;
      a.click();
      URL.revokeObjectURL(url);
    }

    $("compileForm").addEventListener("submit", runCompilation);
    $("copyBtn").addEventListener("click", copyArtifact);
    $("downloadBtn").addEventListener("click", downloadArtifact);
    document.querySelectorAll("[role=tab]").forEach((tab) => {
      tab.addEventListener("click", () => showTab(tab.dataset.tab));
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
        const other = tab.dataset.tab === "output" ? "files" : "output";
        showTab(other);
        $(`tab-${other}`).focus();
      });
    });

    {% if auto_run %}
    // URL-swap pages (/<owner>/<repo>) compress immediately.
    runCompilation();
    {% endif %}
    </script>
  </body>
</html>
