<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ContextCraft — AST-Aware, Token-Budgeted Codebase Compressor</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            slate: {
              850: '#151f32',
              950: '#0a0f1a'
            }
          }
        }
      }
    };
    </script>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased selection:bg-indigo-500 selection:text-white">
    <!-- Top Navigation Header -->
    <header class="border-b border-slate-800 bg-slate-900/70 backdrop-blur sticky top-0 z-30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-500 to-cyan-400 flex items-center justify-center font-bold text-slate-950 shadow-lg shadow-indigo-500/20">
            CC
          </div>
          <div>
            <span class="font-bold text-lg tracking-tight text-white"
            >ContextCraft</span>
            <span
              class="ml-2 text-xs font-mono px-2 py-0.5 rounded-full bg-indigo-500/15 text-indigo-300 border border-indigo-500/30"
            >
              v{{ version }}
            </span>
          </div>
        </div>
        <div class="flex items-center space-x-4 text-sm">
          <span class="hidden md:inline-block text-slate-400">
            Tree-sitter AST + Personalized PageRank + Multiple-Choice Knapsack
          </span>
          <a
            href="/api/health"
            target="_blank"
            class="text-xs font-mono px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 hover:bg-emerald-500/20 transition"
          >
            API Ready
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      <!-- Hero & Control Panel -->
      <section class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl">
        <div class="max-w-3xl mb-6">
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
            Compile Any Repository Into Your Exact Token Budget
          </h1>
          <p class="mt-2 text-slate-400 text-sm sm:text-base">
            Unlike naive concatenation tools (<code class="text-indigo-300"
            >repomix</code>, <code class="text-indigo-300">gitingest</code>),
            ContextCraft parses the AST, scores architectural centrality via
            <strong>Personalized PageRank</strong>, and solves a <strong
            >Multiple-Choice Knapsack Problem</strong> across 4 resolution tiers
            (<code class="text-emerald-400">FULL</code>, <code
              class="text-cyan-400"
            >SKEL</code>, <code class="text-amber-400">SIGS</code>, <code
              class="text-slate-400"
            >TREE</code>).
          </p>
        </div>

        <form id="compileForm" class="space-y-4">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
            <!-- Repository Path or GitHub URL -->
            <div class="lg:col-span-5">
              <label
                class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5"
              >
                Local Repo Path or GitHub URL
              </label>
              <input
                type="text"
                id="sourceInput"
                value="{{ initial_source }}"
                placeholder=". or https://github.com/owner/repo"
                class="w-full px-3.5 py-2.5 rounded-lg bg-slate-950 border border-slate-700 text-slate-100 font-mono text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
                required
              />
            </div>

            <!-- Focus Query -->
            <div class="lg:col-span-4">
              <label
                class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5"
              >
                Personalized PageRank Focus Query (<code class="text-indigo-300"
                >--focus</code>)
              </label>
              <input
                type="text"
                id="focusInput"
                value="{{ initial_focus }}"
                placeholder="e.g., AST elision and knapsack optimizer"
                class="w-full px-3.5 py-2.5 rounded-lg bg-slate-950 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
              />
            </div>

            <!-- Strict Token Budget -->
            <div class="lg:col-span-3">
              <label
                class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5"
              >
                Strict Token Budget (<code class="text-indigo-300"
                >--budget</code>)
              </label>
              <div class="flex space-x-2">
                <input
                  type="text"
                  id="budgetInput"
                  value="{{ initial_budget }}"
                  placeholder="16k"
                  class="w-full px-3.5 py-2.5 rounded-lg bg-slate-950 border border-slate-700 text-slate-100 font-mono text-sm focus:outline-none focus:border-indigo-500"
                  required
                />
                <select
                  id="formatSelect"
                  class="px-3 py-2.5 rounded-lg bg-slate-950 border border-slate-700 text-slate-200 text-sm font-mono focus:outline-none focus:border-indigo-500"
                >
                  <option
                    value="markdown"
                    {% if initial_format == 'markdown' %}selected{% endif %}
                  >
                    MD
                  </option>
                  <option
                    value="xml"
                    {% if initial_format == 'xml' %}selected{% endif %}
                  >
                    XML
                  </option>
                  <option
                    value="json"
                    {% if initial_format == 'json' %}selected{% endif %}
                  >
                    JSON
                  </option>
                </select>
              </div>
            </div>
          </div>

          <!-- Quick Budget Presets & Submit -->
          <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="text-slate-400 font-medium">Quick Budgets:</span>
              <button
                type="button"
                onclick="setBudget('2k')"
                class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono transition"
              >
                2k
              </button>
              <button
                type="button"
                onclick="setBudget('4k')"
                class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono transition"
              >
                4k
              </button>
              <button
                type="button"
                onclick="setBudget('8k')"
                class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono transition"
              >
                8k
              </button>
              <button
                type="button"
                onclick="setBudget('16k')"
                class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono transition"
              >
                16k
              </button>
              <button
                type="button"
                onclick="setBudget('32k')"
                class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono transition"
              >
                32k
              </button>
              <button
                type="button"
                onclick="setBudget('64k')"
                class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono transition"
              >
                64k
              </button>
              <label
                class="inline-flex items-center ml-3 space-x-2 text-slate-300 cursor-pointer"
              >
                <input
                  type="checkbox"
                  id="redactCheckbox"
                  checked
                  class="rounded bg-slate-950 border-slate-700 text-indigo-500 focus:ring-0"
                />
                <span>Scrub API Keys & Secrets</span>
              </label>
            </div>

            <button
              type="submit"
              id="compileBtn"
              class="px-6 py-2.5 rounded-lg bg-gradient-to-r from-indigo-500 to-cyan-500 hover:from-indigo-600 hover:to-cyan-600 text-slate-950 font-bold text-sm shadow-lg shadow-indigo-500/20 transition flex items-center space-x-2"
            >
              <span id="compileBtnText">Compile Context Artifact</span>
            </button>
          </div>
        </form>

        <!-- Error Banner -->
        <div
          id="errorBanner"
          class="hidden mt-4 p-4 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm font-mono"
        >
        </div>
      </section>

      <!-- Telemetry Dashboard Cards -->
      <section id="resultsSection" class="hidden space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
            <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">
              Compression Ratio
            </div>
            <div
              id="statRatio"
              class="mt-1 text-2xl font-extrabold text-emerald-400 font-mono"
            >
              -
            </div>
            <div id="statSavings" class="mt-1 text-xs text-slate-400">-</div>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
            <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">
              Strict Token Budget
            </div>
            <div
              id="statTokens"
              class="mt-1 text-2xl font-extrabold text-cyan-400 font-mono"
            >
              -
            </div>
            <div id="statRawTokens" class="mt-1 text-xs text-slate-400">-</div>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
            <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">
              AST Fidelity Tiers
            </div>
            <div
              id="statFidelity"
              class="mt-2 flex flex-wrap gap-1.5 text-xs font-mono"
            >
            </div>
            <div id="statSignatures" class="mt-2 text-xs text-slate-400">-</div>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
            <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">
              Security & Latency
            </div>
            <div
              id="statLatency"
              class="mt-1 text-2xl font-extrabold text-indigo-400 font-mono"
            >
              -
            </div>
            <div id="statSecrets" class="mt-1 text-xs text-amber-400 font-mono">
              -
            </div>
          </div>
        </div>

        <!-- Two-Column Workspace: Compiled Output & PageRank Table -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- Compiled Artifact Viewer (7 cols) -->
          <div class="lg:col-span-7 bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden flex flex-col">
            <div class="px-5 py-3.5 border-b border-slate-800 flex items-center justify-between bg-slate-900/90">
              <span class="font-semibold text-sm text-white"
              >Compiled LLM Context Artifact</span>
              <div class="flex items-center space-x-2">
                <button
                  type="button"
                  onclick="copyArtifact()"
                  id="copyBtn"
                  class="px-3 py-1.5 rounded-lg bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-300 border border-indigo-500/30 text-xs font-semibold transition"
                >
                  Copy to Clipboard
                </button>
                <button
                  type="button"
                  onclick="downloadArtifact()"
                  class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition"
                >
                  Download
                </button>
              </div>
            </div>
            <pre
              id="artifactOutput"
              class="p-5 text-xs font-mono text-slate-200 overflow-x-auto overflow-y-auto max-h-[600px] leading-relaxed bg-slate-950/70"
            ></pre>
          </div>

          <!-- PageRank Centrality Breakdown Table (5 cols) -->
          <div class="lg:col-span-5 bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden flex flex-col">
            <div class="px-5 py-3.5 border-b border-slate-800 bg-slate-900/90">
              <span class="font-semibold text-sm text-white"
              >Personalized PageRank & Fidelity Assignment</span>
            </div>
            <div class="overflow-x-auto overflow-y-auto max-h-[600px]">
              <table class="w-full text-left border-collapse text-xs">
                <thead class="bg-slate-950/80 text-slate-400 uppercase font-semibold sticky top-0">
                  <tr>
                    <th class="py-2.5 px-3">File</th>
                    <th class="py-2.5 px-2 text-center">Tier</th>
                    <th class="py-2.5 px-2 text-right">PageRank</th>
                    <th class="py-2.5 px-3 text-right">Tokens</th>
                  </tr>
                </thead>
                <tbody
                  id="filesTableBody"
                  class="divide-y divide-slate-800/70 font-mono"
                >
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script>
    let latestContent = "";
    let latestFormat = "markdown";

    function setBudget(val) {
      document.getElementById("budgetInput").value = val;
    }

    function badgeHtml(tier) {
      const styles = {
        FULL: "bg-emerald-500/15 text-emerald-400 border-emerald-500/30",
        SKEL: "bg-cyan-500/15 text-cyan-400 border-cyan-500/30",
        SIGS: "bg-amber-500/15 text-amber-300 border-amber-500/30",
        TREE: "bg-slate-800 text-slate-400 border-slate-700"
      };
      const cls = styles[tier] || styles.TREE;
      return `<span class="px-2 py-0.5 rounded border text-[11px] font-bold ${cls}">${tier}</span>`;
    }

    async function runCompilation(e) {
      if (e) e.preventDefault();
      const btn = document.getElementById("compileBtn");
      const btnText = document.getElementById("compileBtnText");
      const errBanner = document.getElementById("errorBanner");
      errBanner.classList.add("hidden");

      btn.disabled = true;
      btnText.textContent = "Compiling AST & PageRank...";

      const payload = {
        source: document.getElementById("sourceInput").value.trim() || ".",
        budget: document.getElementById("budgetInput").value.trim() || "16k",
        focus_query: document.getElementById("focusInput").value.trim() || null,
        output_format: document.getElementById("formatSelect").value,
        redact_secrets: document.getElementById("redactCheckbox").checked
      };

      try {
        const resp = await fetch("/api/compile", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const data = await resp.json();
        if (!resp.ok) {
          throw new Error(data.detail || "Compilation failed");
        }

        latestContent = data.content;
        latestFormat = data.output_format;
        const s = data.stats;

        document.getElementById("statRatio").textContent = `${s.compression_ratio}x`;
        document.getElementById("statSavings").textContent = `${s.token_savings_pct}% tokens saved (${s.files_compiled} files)`;
        document.getElementById("statTokens").textContent = `${s.compressed_tokens.toLocaleString()} / ${s.budget_tokens.toLocaleString()}`;
        document.getElementById("statRawTokens").textContent = `Raw repository: ${s.raw_tokens.toLocaleString()} tokens (${s.budget_utilization_pct}% budget used)`;

        const fc = s.fidelity_counts || {};
        document.getElementById("statFidelity").innerHTML = `
          ${badgeHtml("FULL")} <span>${fc.FULL || 0}</span>
          ${badgeHtml("SKEL")} <span>${fc.SKEL || 0}</span>
          ${badgeHtml("SIGS")} <span>${fc.SIGS || 0}</span>
          ${badgeHtml("TREE")} <span>${fc.TREE || 0}</span>
        `;
        document.getElementById("statSignatures").textContent = `Signature coverage: ${s.preserved_signatures_pct}% (${s.total_symbols_extracted} AST symbols)`;
        document.getElementById("statLatency").textContent = `${s.execution_time_ms} ms`;
        document.getElementById("statSecrets").textContent = `${s.secrets_redacted} secrets scrubbed`;

        document.getElementById("artifactOutput").textContent = data.content;

        const tbody = document.getElementById("filesTableBody");
        tbody.innerHTML = data.files.map(f => `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="py-2 px-3 text-slate-200 truncate max-w-[200px]" title="${f.rel_path}">${f.rel_path}</td>
            <td class="py-2 px-2 text-center">${badgeHtml(f.fidelity)}</td>
            <td class="py-2 px-2 text-right text-cyan-400">${f.pagerank_pct.toFixed(1)}%</td>
            <td class="py-2 px-3 text-right text-slate-300">${f.selected_tokens.toLocaleString()} <span class="text-slate-500">/ ${f.raw_tokens.toLocaleString()}</span></td>
          </tr>
        `).join("");

        document.getElementById("resultsSection").classList.remove("hidden");
      } catch (err) {
        errBanner.textContent = `Error: ${err.message}`;
        errBanner.classList.remove("hidden");
      } finally {
        btn.disabled = false;
        btnText.textContent = "Compile Context Artifact";
      }
    }

    async function copyArtifact() {
      if (!latestContent) return;
      await navigator.clipboard.writeText(latestContent);
      const copyBtn = document.getElementById("copyBtn");
      const oldText = copyBtn.textContent;
      copyBtn.textContent = "Copied!";
      setTimeout(() => { copyBtn.textContent = oldText; }, 1800);
    }

    function downloadArtifact() {
      if (!latestContent) return;
      const extMap = { markdown: "md", xml: "xml", json: "json" };
      const ext = extMap[latestFormat] || "txt";
      const blob = new Blob([latestContent], { type: "text/plain;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `contextcraft_output.${ext}`;
      a.click();
      URL.revokeObjectURL(url);
    }

    document.getElementById("compileForm").addEventListener("submit", runCompilation);

    // Automatically run on load so local users see immediate results
    window.addEventListener("DOMContentLoaded", () => {
      runCompilation();
    });
    </script>
  </body>
</html>
